.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/

# Local runtime data (never commit generated images or stores)
data/

# Local secrets — any env file, keys and certificates
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
.secrets/

# Netlify CLI local state (contains site id / linked account)
.netlify/
